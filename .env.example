# 端口是 5433 不是 5432 —— 5432 上通常已经有一个系统自带的 Postgres，
# 且这是全仓库代码默认值（main.ts / seed-dev.ts / test/db.ts）。
# docker-compose 也发布在这个端口，用 APOS_PGPORT 可以整体挪。
DATABASE_URL=postgres://apos:apos@localhost:5433/apos
# ★ 必须与 DATABASE_URL 不同：测试会 TRUNCATE 全表
TEST_DATABASE_URL=postgres://apos:apos@localhost:5433/apos_test
# 目前还没有代码读这个变量：MVP 的事件扇出走进程内 EventBus，
# Redis 是留给后续 BullMQ 队列与多实例 SSE 扇出的
REDIS_URL=redis://localhost:6379

PORT=3000
LOG_LEVEL=info

# 平台自身用（Project Agent、需求结构化）
ANTHROPIC_API_KEY=

# ── Claude Code 运行时 ──────────────────────────────────────────────
# ★ Agent 用的凭证与平台分开。产品文档 10.2：Agent 是独立身份，
#   权限独立配置，不复用人类或平台的 token。
#   未设置时 Claude Code 适配器会拒绝派发（而不是悄悄回退到上面那个 key）。
APOS_AGENT_ANTHROPIC_API_KEY=

# ── Codex 运行时 ────────────────────────────────────────────────────
# 同样与平台凭证分开。需要 codex CLI 在 PATH 中。
APOS_AGENT_OPENAI_API_KEY=

# ── 凭证加密 ────────────────────────────────────────────────────────
# ★ 界面上粘贴的运行时 / 仓库凭证用它加密后入库，钥匙住在库外 ——
#   拿到一份数据库导出的人解不开任何一条凭证。
#   不设置也能用：改在界面里填 `env:变量名`，凭证就只留在进程环境。
APOS_SECRET_KEY=

# ── 工作区供给 ──────────────────────────────────────────────────────
# 所有 Run 的工作树根目录。镜像缓存在 <root>/mirrors，
# 每个 Run 的独立工作树在 <root>/runs/<runId>。需要 git ≥ 2.31。
AGENT_WORKSPACE_ROOT=

# 执行失败时是否把 Agent 的半成品分支推到远端。
# 默认 false：改动留在本地镜像的分支上可事后捞，远端不被半成品淹没。
APOS_WORKSPACE_PUSH_ON_FAILURE=false

# ── run-supervisor ──────────────────────────────────────────────────
# 多久没有任何事件算失联。协议要求 ≥ 3×心跳间隔且不少于 90s。
# ★ 失联不等于判死：supervisor 会先向运行时求证，
#   运行时说还在跑就只续心跳 —— 否则跑长任务的 Agent 会被误杀。
RUN_HEARTBEAT_TIMEOUT_MS=90000
