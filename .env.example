# 端口是 5433 不是 5432 —— 5432 上通常已经有一个系统自带的 Postgres，
# 且这是全仓库代码默认值（main.ts / seed-dev.ts / test/db.ts）。
# docker-compose 也发布在这个端口，用 APOS_PGPORT 可以整体挪。
DATABASE_URL=postgres://apos:apos@localhost:5433/apos
# ★ 必须与 DATABASE_URL 不同：测试会 TRUNCATE 全表
TEST_DATABASE_URL=postgres://apos:apos@localhost:5433/apos_test

# ── 接托管 Postgres（Supabase 等）───────────────────────────────────
# 完整步骤见 docs/SUPABASE.md。这里只说这三个变量之间的关系。
#
# 上面的 DATABASE_URL 换成 Supabase 的连接串即可，代码会自己认出连的是
# 直连、Session Pooler 还是 Transaction Pooler，并据此决定预编译语句与 TLS
# （判定规则见 packages/db/src/connection.ts，启动日志第一行会打印结果）。
# 控制台复制来的 `?supa=base-pooler.x` 不用手工删。
#
# ★★ DDL 不要走 Transaction Pooler（:6543）。那个池子按语句而不是按会话
#   分配后端连接，而迁移依赖会话内的连续性。它不一定当场报错，更常见的是
#   跑到一半失败 —— 而迁移失败最贵的形态就是「一半应用了」。
#   所以后端走 :6543 时，把直连或 Session Pooler 的串放这里给迁移用。
#   本机与 docker-compose 下两者本来就是同一个，留空即可。
DATABASE_DIRECT_URL=

# 单进程的连接池大小，不设默认 10。
# ★ 托管 Postgres 的连接数是硬上限（Supabase 免费档直连 60 条），
#   而 api 与 worker 是两个进程 —— 默认值下就占 20 条。走 Transaction
#   Pooler 时它替你复用后端连接，这里可以放心；走直连/Session Pooler
#   且副本多的话要往下调。超了的表现是「一部分请求卡住直到超时」。
APOS_DB_POOL_MAX=
# 目前还没有代码读这个变量：MVP 的事件扇出走进程内 EventBus，
# Redis 是留给后续 BullMQ 队列与多实例 SSE 扇出的
REDIS_URL=redis://localhost:6379

PORT=3000
LOG_LEVEL=info

# ── 身份与登录 ──────────────────────────────────────────────────────
# ★★ 超级管理员 —— 整套身份体系的根。
#
#   账号只能由组织管理员创建（没有自助注册：组织边界就是多租户边界），
#   而第一个管理员没人能创建他。所以他必须来自数据库之外，也就是这里。
#   启动时幂等自举：账号不存在就建出来，并给他建一个组织。
#
# ★ 这里的口令是**初始**口令，只在建号那一次用。之后他在界面上改了口令，
#   重启不会被这一行打回去 —— 否则 .env 里这个值就成了一个改不掉的后门。
#   登录后请第一时间修改。
APOS_SUPERADMIN_EMAIL=admin@example.com
APOS_SUPERADMIN_PASSWORD=change-me-please
APOS_SUPERADMIN_NAME=超级管理员
# 自举时如果他还不属于任何组织，用这个名字建一个
APOS_SUPERADMIN_ORG=默认组织

# ★★ 自助注册的总开关。默认**开着** —— 不写这一行就是开的。
#
#   注册开的是一个**属于注册者自己的新组织**，不是加入某个已有组织：
#   谁也进不到别人的边界里。要进已有组织仍然只有「被那个组织的管理员
#   加进去」一条路。详见 docs/tech/09-security.md §1。
#
# ★ 认不出来的取值一律按**关闭**处理，并在启动日志里说明。
#   写成 APOS_ALLOW_SIGNUP=flase 却当成开着的话，是「明明想关却一直开着」
#   且毫无迹象；按关处理最多是有人报「注册按钮不见了」。
#   可用取值：1/true/yes/on/enabled 与 0/false/no/off/disabled
APOS_ALLOW_SIGNUP=true

# ★★ 会话令牌（JWT）的签名密钥。
#
#   不设置也能跑：每个进程随机生成一把，代价是**重启后所有人要重新登录**。
#   多副本部署时必须设置 —— 否则 A 副本签的令牌 B 副本验不过，
#   表现是「随机掉线」，而且完全不指向配置。
APOS_JWT_SECRET=
# 令牌有效期（秒）。令牌是无状态的，改口令、停用账号都要等它自然过期，
# 所以不宜太长。默认 12 小时。
APOS_JWT_TTL_SECONDS=43200

# 平台自身用（Project Agent、需求结构化）
ANTHROPIC_API_KEY=

# ── Claude Code 运行时 ──────────────────────────────────────────────
# ★ Agent 用的凭证与平台分开。产品文档 10.2：Agent 是独立身份，
#   权限独立配置，不复用人类或平台的 token。
#   未设置时 Claude Code 适配器会拒绝派发（而不是悄悄回退到上面那个 key）。
APOS_AGENT_ANTHROPIC_API_KEY=

# ── Codex 运行时 ────────────────────────────────────────────────────
# 同样与平台凭证分开。需要 codex CLI 在 PATH 中。
APOS_AGENT_OPENAI_API_KEY=

# ── 需求规划（结构化与计划生成）──────────────────────────────────────
# ★★ 规划走**真实 Agent 运行时**，不是直接调 LLM API：平台在
#   AGENT_WORKSPACE_ROOT/planning/<runId>/ 下开一个目录，写进 BRIEF.md，
#   让 claude-code / codex 这类 CLI 在里面干活，最后读回 apos-output.json。
#
# ★ 用哪个 Agent 不在这里配，在界面上配：组织里任意一个
#   **applicableTypes 含 requirement** 的启用中 Agent 就会被选上
#   （复用工作项类型，不另发明一套「规划 Agent」概念）。
#   凭证也在那个 Agent 上，与执行 Agent 各自独立。
#
# ★ 没配、凭证缺失、超时、产出不合格 —— 一律回退到规则占位，
#   **并把原因写进需求页与计划页的 model 字段**。回退可以，装作没回退不行。
#
# 单次规划的墙钟上限（毫秒）。规划 Run 不在 agent_runs 里，
# supervisor 管不到它，超时只能靠这个值。实际取它与 Agent 自身
# timeoutSeconds 的较小值。
PLANNING_TIMEOUT_MS=600000

# ── 凭证加密 ────────────────────────────────────────────────────────
# ★ 界面上粘贴的运行时 / 仓库凭证用它加密后入库，钥匙住在库外 ——
#   拿到一份数据库导出的人解不开任何一条凭证。
#   不设置也能用：改在界面里填 `env:变量名`，凭证就只留在进程环境。
APOS_SECRET_KEY=

# ── 工作区供给 ──────────────────────────────────────────────────────
# 所有 Run 的工作树根目录。镜像缓存在 <root>/mirrors，
# 每个 Run 的独立工作树在 <root>/runs/<runId>。需要 git ≥ 2.31。
AGENT_WORKSPACE_ROOT=

# 执行失败时是否把 Agent 的半成品分支推到远端。
# 默认 false：改动留在本地镜像的分支上可事后捞，远端不被半成品淹没。
APOS_WORKSPACE_PUSH_ON_FAILURE=false

# ── run-supervisor ──────────────────────────────────────────────────
# 多久没有任何事件算失联。协议要求 ≥ 3×心跳间隔且不少于 90s。
# ★ 失联不等于判死：supervisor 会先向运行时求证，
#   运行时说还在跑就只续心跳 —— 否则跑长任务的 Agent 会被误杀。
RUN_HEARTBEAT_TIMEOUT_MS=90000
