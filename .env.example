# 端口是 5433 不是 5432 —— 5432 上通常已经有一个系统自带的 Postgres，
# 且这是全仓库代码默认值（main.ts / seed-dev.ts / test/db.ts）。
# docker-compose 也发布在这个端口，用 APOS_PGPORT 可以整体挪。
DATABASE_URL=postgres://apos:apos@localhost:5433/apos
# ★ 必须与 DATABASE_URL 不同：测试会 TRUNCATE 全表
TEST_DATABASE_URL=postgres://apos:apos@localhost:5433/apos_test
# 目前还没有代码读这个变量：MVP 的事件扇出走进程内 EventBus，
# Redis 是留给后续 BullMQ 队列与多实例 SSE 扇出的
REDIS_URL=redis://localhost:6379

PORT=3000
LOG_LEVEL=info

# 平台自身用（Project Agent、需求结构化）
ANTHROPIC_API_KEY=

# ── Claude Code 运行时 ──────────────────────────────────────────────
# ★ Agent 用的凭证与平台分开。产品文档 10.2：Agent 是独立身份，
#   权限独立配置，不复用人类或平台的 token。
#   未设置时 Claude Code 适配器会拒绝派发（而不是悄悄回退到上面那个 key）。
APOS_AGENT_ANTHROPIC_API_KEY=

# Agent 可写的工作目录根。未设置时 claude_code 运行时拒绝派发。
AGENT_WORKSPACE_ROOT=
